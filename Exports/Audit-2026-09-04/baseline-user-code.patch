+        "vol=\(guest?.volume ?? -1) fade=\(guest?.fadeIn.type.rawValue ?? "missing")"
+    )
+}
+
+do {
+    let aID = UUID()
+    let bID = UUID()
+    let stay = 4.2
+    let plan = AutoRemixPlan(
+        mode: .mashup,
+        targetBPM: 124,
+        targetDuration: 24,
+        anchorSongIDs: [aID],
+        selectedSections: [],
+        placements: [
