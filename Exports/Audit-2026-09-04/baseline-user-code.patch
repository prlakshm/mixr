+    /// the new lead can take the foreground without a flush cut.
+    private static func rideLayerVolumes(
+        _ plan: inout AutoRemixPlan,
+        outgoingIndex: Int,
+        incomingIndex: Int,
+        keepIncomingHardCut: Bool
